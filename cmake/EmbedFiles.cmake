# Files built into the program: at build time each one becomes a byte array
# in a generated .inc, so the program doesn't need them on disk. (A byte
# array, not a string literal: MSVC limits a literal's length.)
#
#   reluva_embed_files(<target> <output.inc> BASE <dir> FILES <file>...)
#
# writes <output.inc> (in the build tree; on <target>'s include path) and
# rebuilds it when any of the files change. A source file includes it
# where it has declared
#
#   struct EmbeddedFile {
#       const char* name;          // its path from BASE's parent: scripts/c4.nws
#       const unsigned char* data;
#       std::size_t size;
#   };
#
# and gets kEmbeddedFiles[], one for each file in the order given. Run as
# a script (cmake -P), this file writes the .inc:
#   cmake -DOUTPUT=<output.inc> -DBASE=<dir> -P EmbedFiles.cmake -- <file>...

if(CMAKE_SCRIPT_MODE_FILE)
    set(files "")
    set(after FALSE)
    math(EXPR last "${CMAKE_ARGC} - 1")
    foreach(i RANGE ${last})
        if(after)
            list(APPEND files "${CMAKE_ARGV${i}}")
        elseif(CMAKE_ARGV${i} STREQUAL "--")
            set(after TRUE)
        endif()
    endforeach()
    get_filename_component(base_name "${BASE}" NAME)
    set(out "// Generated by cmake/EmbedFiles.cmake from ${base_name}/: edit those files, not this.\n\n")
    set(table "")
    set(n 0)
    string(REPEAT "0x..," 24 row) # (CMake's regular expressions have no {24})
    foreach(file IN LISTS files)
        file(READ "${BASE}/${file}" hex HEX)
        if(hex STREQUAL "")
            message(FATAL_ERROR "${BASE}/${file} is empty")
        endif()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
        string(REGEX REPLACE "(${row})" "\\1\n    " hex "${hex}")
        string(APPEND out "constexpr unsigned char kEmbedded${n}[] = {\n    ${hex}\n};\n")
        string(APPEND table "    {\"${base_name}/${file}\", kEmbedded${n}, sizeof kEmbedded${n}},\n")
        math(EXPR n "${n} + 1")
    endforeach()
    string(APPEND out "\nconstexpr EmbeddedFile kEmbeddedFiles[] = {\n${table}};\n")
    file(WRITE "${OUTPUT}" "${out}")
    return()
endif()

set(RELUVA_EMBED_FILES_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(reluva_embed_files target output)
    cmake_parse_arguments(PARSE_ARGV 2 arg "" "BASE" "FILES")
    set(inputs "")
    foreach(file IN LISTS arg_FILES)
        list(APPEND inputs "${arg_BASE}/${file}")
    endforeach()
    set(out "${CMAKE_CURRENT_BINARY_DIR}/generated/${output}")
    add_custom_command(
        OUTPUT "${out}"
        COMMAND "${CMAKE_COMMAND}" "-DOUTPUT=${out}" "-DBASE=${arg_BASE}" -P "${RELUVA_EMBED_FILES_SCRIPT}" -- ${arg_FILES}
        DEPENDS ${inputs} "${RELUVA_EMBED_FILES_SCRIPT}"
        COMMENT "Embedding ${output}"
        VERBATIM)
    target_sources(${target} PRIVATE "${out}")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
endfunction()
